# Copy to .env.local and adjust per environment. Never commit .env.local.
# All variables must be read through src/lib/env.ts — never process.env inline.

# Canonical site URL, used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web3Forms access key for the contact form (get one at https://web3forms.com).
# Public by design, but inlined at build time — set it in the host's build
# environment (Render → Environment) as well as locally.
NEXT_PUBLIC_WEB3FORMS_KEY=
